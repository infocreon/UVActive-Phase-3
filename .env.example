# UV Active — Branch Portal — environment variables
# Copy to .env for local dev. In production, set these on the host/
# platform directly (Render/Vercel/etc) — never commit a real .env.

# Base URL of uvactive-unified-backend, including the /api/v1 prefix.
# This ONE backend serves Admin Panel, Branch Portal, Trainer App and
# Member App together (SERVICE_SCOPE=all) — access to each realm's
# routes is enforced by which JWT the request carries (this app's
# login issues a "staff" token scoped to one gym), not by which URL
# you point at.
#
# Local dev: run `npm run start:dev` inside uvactive-unified-backend
# (default port 8080), then point this at it.
#   Local:      http://localhost:8080/api/v1
#   Production: https://<your-backend-deployment>/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Identity Services Web client ID — same value you set as
# GOOGLE_STAFF_CLIENT_ID in the backend's .env. Leave blank to hide
# the "Sign in with Google" button (password + TOTP still works fully).
VITE_GOOGLE_STAFF_CLIENT_ID=
