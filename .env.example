# UV Active Member App — environment variables
#
# Expo only inlines vars prefixed EXPO_PUBLIC_ into the built app at
# build time (see https://docs.expo.dev/guides/environment-variables/)
# — anything else here would silently be undefined on device. Copy
# this file to .env for local dev; for EAS builds, set the same keys
# as EAS "Environment Variables" per build profile instead (a local
# .env is NOT picked up by `eas build`).

# Base URL of the UV Active unified backend, including the /api/v1
# prefix. REQUIRED — src/config.ts throws at startup if this is unset,
# there is no hardcoded fallback. Set this explicitly for local dev
# against a backend running on your own machine, and for any
# dev/preview/production EAS build (as an EAS "Environment Variable"
# on that build profile — eas.json intentionally has no "env" block).
# Local dev against a backend on the same machine: use your computer's
# LAN IP, not localhost — a physical device or the Android emulator
# can't reach your machine's localhost.
#   iOS simulator:      http://localhost:8080/api/v1
#   Android emulator:   http://10.0.2.2:8080/api/v1
#   Physical device:    http://<your-computer's-LAN-IP>:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
